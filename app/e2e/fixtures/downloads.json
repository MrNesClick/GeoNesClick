    {
      "hosts": [
        "github.com",
        "objects.githubusercontent.com"
      ],
      "id": "python",
      "license": "PSF-2.0",
      "required": true,
      "size_mb": 30,
      "when": "installation"
    },
    {
      "hosts": [
        "pypi.org",
        "files.pythonhosted.org"
      ],
      "id": "packages",
      "license": "various (BSD, MIT, Apache-2.0…), detailed package by package below",
      "required": true,
      "size_mb": 3060,
      "when": "installation"
    },
    {
      "hosts": [
        "download.pytorch.org"
      ],
      "id": "pytorch-cpu",
      "license": "BSD-3-Clause",
